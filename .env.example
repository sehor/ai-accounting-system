DB_URL=jdbc:postgresql://127.0.0.1:5432/ai-accounting
DB_USERNAME=postgres
DB_PASSWORD=postgres
STORAGE_ROOT=./data/files
# Local-only dev bearer credentials; never use them outside local development.
DEV_BEARER_TOKEN=dev-admin-token
DEV_BEARER_USER_ID=00000000-0000-4000-8000-000000000001
# Enable the oidc profile for Bearer-token authentication.
OIDC_ISSUER_URI=https://your-oidc-provider.example.com/realms/your-realm
# Python async clients can use the equivalent URL (replace the placeholder password).
POSTGRES_DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5432/ai-accounting
